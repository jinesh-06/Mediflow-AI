# ResiliHealth AI Environment Variables
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google AI (Gemini) API Key
# If omitted or invalid, ResiliHealth AI automatically activates its deterministic grounded reasoning fallback engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Dual authorization threshold for resource redistribution (units)
DUAL_AUTH_THRESHOLD=1000
